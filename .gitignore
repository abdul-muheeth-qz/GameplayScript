# The run folders. They live in server/, beside the code and the config that make them; the
# bare pattern matches at any depth, so a leftover captured_files/ at the root is covered too.
captured_files/
__pycache__/
*.pyc

# One environment for the whole app (server/.venv), and it is not committed.
.venv/
venv/
env/
ENV/

# UI
ui/node_modules/
ui/dist/
ui/.vite/
npm-debug.log*
